# Public frontend configuration only. Never put secrets in VITE_*.
VITE_API_BASE_URL=/api
VITE_API_ENABLED=false
# Dev proxy only: adapt to the port used by Spring Boot (for example 8081).
API_PROXY_TARGET=http://127.0.0.1:8080

# MongoDB Local / Docker configuration (J03)
MONGO_INITDB_ROOT_USERNAME=olive_admin
MONGO_INITDB_ROOT_PASSWORD=olive_secret_change_me
MONGO_INITDB_DATABASE=oliveconnect
MONGODB_URI=mongodb://localhost:27017/oliveconnect

# Security & Seeder (Dev only - J03)
JWT_SECRET=oliveconnect-secure-jwt-secret-key-sfax-2026-super-safe-minimum-256-bits
SEED_DEFAULT_PASSWORD=ChangeMeDevPassword123!
